# Repo is LF everywhere (index and working tree) on every OS. Owner's Windows box has core.autocrlf=true, which caused 'LF will be replaced by CRLF' warnings on 24+ files.
* text=auto eol=lf
*.sql text eol=lf
*.sh text eol=lf

# Binary assets must never be normalized
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.mp4 binary
*.webm binary
*.zip binary

package-lock.json linguist-generated=true
